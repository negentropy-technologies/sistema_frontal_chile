# Plantilla de variables de entorno para backend/.env (que no se
# commitea, ver .gitignore). Copiar este archivo a backend/.env y
# completar cada valor real.

# --- Google Earth Engine ---
GEE_PROJECT=
GEE_USER=

# --- Google Cloud Maps Platform ---
GCP_MAPS_PLATASFORM_API_KEY=

# --- USGS EarthExplorer M2M API (Landsat) ---
M2M_USERNAME=
M2M_PASSWORD=

# --- Copernicus (Sentinel) ---
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# --- NASA Earthdata (GPM IMERG, MODIS) ---
EARTHDATA_USER=
EARTHDATA_PASSWORD=

# --- NOAA / NCEI ---
NOAA_USER=
NOAA_API_KEY=

# --- Postgres/PostGIS: base de datos compartida de Negentropy ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Rol de BD acotado frontal_sur_app, para el pipeline de ingesta ---
# (se agrega en la Tarea 3 del plan de esquema de BD, no usar DB_USER/
# DB_PASSWORD del superusuario para el pipeline automatizado)
DB_APP_USER=
DB_APP_PASSWORD=

# --- Tunel SSH hacia la base de datos remota ---
SSH_HOST=
SSH_USER=
SSH_PORT=
SSH_KEY_PATH=
SSH_REMOTE_DB_PORT=

# --- URL de conexion directa (si no se usa tunel SSH) ---
DATABASE_URL=

# --- Hugging Face ---
HF_TOKEN=

# --- Martin (servidor de vector tiles) ---
MARTIN_DB_USER=
MARTIN_DB_PASSWORD=

# --- Otros ---
CORREO=
API_KEY=